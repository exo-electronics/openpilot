[Unit]
Description=openpilot (EOP RK3576 / ExoPilot 02M)
After=network-online.target rockchip.service
Wants=network-online.target
Conflicts=visionpilot.service dorapilot.service

[Service]
Type=simple
User=root
WorkingDirectory=@@DIR@@
Environment=OPENPILOT_PREFIX=rk3576
EnvironmentFile=-/etc/openpilot/env

ExecStartPre=/bin/bash -c 'source /etc/profile.d/99-rockchip-rk3576-env.sh 2>/dev/null || true'
# Bounded camera wait. openpilot-rk3588.service uses an unbounded
# `until [ -e ... ]` loop, so a device whose cameras never enumerate sits in
# ExecStartPre forever with nothing in the journal explaining why. Fail after
# 30s with a message and let Restart= retry instead.
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do [ -e /dev/video-camera0 ] && exit 0; sleep 0.5; done; echo "camera node /dev/video-camera0 did not appear within 30s"; exit 1'

ExecStart=/bin/bash @@DIR@@/launch_openpilot.sh

Restart=on-failure
RestartSec=5

# Deliberately no LimitAS/LimitRSS. openpilot-rk3588.service carries
# LimitAS=3G / LimitRSS=2G, which cap the whole cgroup -- manager forks ~45
# supervised processes, and on an 8GB board their combined RSS legitimately
# exceeds 2G once modeld and the camera daemons are warm. A cap there shows up
# as daemons being OOM-killed at random under load rather than as an obvious
# configuration error. The 01M unit should probably lose them too.
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target
