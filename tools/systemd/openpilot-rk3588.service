[Unit]
Description=openpilot (EOP RK3588)
After=network-online.target rockchip.service
Wants=network-online.target
Conflicts=visionpilot.service

[Service]
Type=simple
User=root
WorkingDirectory=@@DIR@@
Environment=OPENPILOT_PREFIX=rk3588
EnvironmentFile=-/etc/openpilot/env

ExecStartPre=/bin/bash -c 'source /etc/profile.d/99-rockchip-rk3588-env.sh 2>/dev/null || true'
# Bounded camera wait. This used to be an unbounded `until [ -e ... ]` loop,
# so a device whose cameras never enumerate sat in ExecStartPre until the
# start timeout with nothing in the journal explaining why. Fail after 30s
# with a message and let Restart= retry instead.
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do [ -e /dev/video-camera0 ] && exit 0; sleep 0.5; done; echo "camera node /dev/video-camera0 did not appear within 30s"; exit 1'

ExecStart=/bin/bash @@DIR@@/launch_openpilot.sh

Restart=on-failure
RestartSec=5

# LimitAS=3G / LimitRSS=2G were removed. Both are setrlimit values applied to
# the service process and inherited by everything manager forks -- about 45
# supervised daemons -- and neither did what it looked like it did:
#
#   LimitAS caps virtual address space, not resident memory. camerad and
#   modeld map large VisionIPC dmabuf regions and the RKNN runtime reserves
#   big VA ranges, so a 3G cap turns into mmap failing with ENOMEM inside a
#   daemon while the board still has free physical RAM.
#
#   LimitRSS sets RLIMIT_RSS, which Linux has not enforced since 2.4. It was
#   dead configuration that read like a working memory bound.
#
# Bounding the stack's memory for real means MemoryMax= on the cgroup, which
# needs a number measured on hardware -- not one guessed here.
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target
